{
    "name": "precision-soft/symfony-json-form-example",
    "description": "The product editor of a product catalogue - its forms described in the backend, serialized to json and rendered by the react components - whose test suite exercises every public capability of precision-soft/symfony-json-form",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "phpdocumentor/reflection-docblock": "5.*",
        "precision-soft/symfony-json-form": "*@dev",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "symfony/property-access": "^7.0 || ^8.0",
        "symfony/property-info": "^7.0 || ^8.0",
        "symfony/serializer": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpunit/phpunit": "^11.5",
        "precision-soft/symfony-phpunit": "^3.0",
        "symfony/phpunit-bridge": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "PrecisionSoft\\Symfony\\JsonForm\\Example\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrecisionSoft\\Dev\\PhpStan\\": "../.dev/phpstan/",
            "PrecisionSoft\\Symfony\\JsonForm\\Example\\Test\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": "simple-phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
